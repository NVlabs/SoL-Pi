{
	"name": "sol-pi",
	"version": "0.1.1",
	"description": "Standalone context and tool-efficiency extensions for Pi",
	"type": "module",
	"private": true,
	"files": [
		"src/sol-pi",
		"assets",
		"docs/compatibility.md",
		"docs/configuration.md",
		"scripts/check-sol-pi-config.mjs",
		"agents-install.md",
		"README.md",
		"LICENSE",
		"CONTRIBUTING.md",
		"SECURITY.md",
		"THIRD_PARTY_NOTICES.md",
		"sol-pi.example.json"
	],
	"scripts": {
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"check": "npm run typecheck && npm test && npm pack --dry-run",
		"check:pi": "node scripts/check-pi-compat.mjs"
	},
	"keywords": [
		"pi-package",
		"pi-extension",
		"context-management"
	],
	"pi": {
		"extensions": [
			"./src/sol-pi/index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": ">=0.84.2",
		"@earendil-works/pi-ai": ">=0.84.2",
		"@earendil-works/pi-coding-agent": ">=0.84.2",
		"@earendil-works/pi-tui": ">=0.84.2",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-agent-core": "1.3.0",
		"@earendil-works/pi-ai": "1.3.0",
		"@earendil-works/pi-coding-agent": "1.3.0",
		"@earendil-works/pi-tui": "1.3.0",
		"@types/node": "24.12.4",
		"typebox": "1.3.27",
		"typescript": "5.9.3",
		"vitest": "4.1.11"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"overrides": {
		"nanoid": "3.3.18",
		"postcss": "8.5.26",
		"protobufjs": "7.6.5",
		"source-map-js": "1.2.2",
		"undici": "8.12.2"
	},
	"license": "MIT"
}
